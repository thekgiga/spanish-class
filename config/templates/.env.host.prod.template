# Environment template for the production VM. Copy to /srv/spanish-class/.env
# on the prod host, then `chmod 600`. Never commit a filled-in version.
#
# Usage on the host:
#   sudo install -m 600 -o deploy -g deploy /dev/stdin /srv/spanish-class/.env <<EOF
#   ...paste filled values...
#   EOF

# ─── Deployment selector ─────────────────────────────────────────────
APP_ENV=prod                            # picks config/prod/.env inside the container
SITE_ADDRESS=spanishclass.com           # public hostname Caddy will serve
ACME_EMAIL=you@example.com              # Let's Encrypt account email

# ─── Container image tags (set by CI; defaults are local-build) ──────
BACKEND_IMAGE=ghcr.io/thekgiga/spanish-class-backend:latest
FRONTEND_IMAGE=ghcr.io/thekgiga/spanish-class-frontend:latest

# Frontend build-time vars (only used during local `docker compose build`)
VITE_API_URL=/api
VITE_SITE_URL=https://spanishclass.com

# ─── MySQL ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=__GENERATE_32_RANDOM__
MYSQL_DATABASE=spanish_class
MYSQL_USER=spanish_class_app
MYSQL_PASSWORD=__GENERATE_32_RANDOM__
