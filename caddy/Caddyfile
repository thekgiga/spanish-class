# Caddyfile — reverse proxy + static frontend + auto Let's Encrypt.
# Substitutions ({$VAR}) come from docker-compose env. Production sets
# DOMAIN to e.g. spanishclass.com; local sets it to :80 for plain HTTP.

{
    email {$ACME_EMAIL}
    # Cloudflare in front does Full (strict) — terminate TLS here with a real cert.
}

{$SITE_ADDRESS} {
    encode zstd gzip

    # Security headers (Cloudflare may layer its own; these are belt+suspenders).
    # CSP allows: Google Fonts (style + font), Sentry (connect), Jitsi (frame).
    # Kept in report-only for the first week of telemetry, then promote to enforce.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        # Jitsi is embedded as an iframe inside our own pages, so we do NOT iframe
        # ourselves anywhere — DENY is correct. The Jitsi frame goes the other way.
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        # microphone+camera 'self' so Jitsi can request permissions on our origin.
        Permissions-Policy        "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://*.sentry.io https://*.ingest.sentry.io; frame-src https://meet.jit.si https://*.jit.si; font-src 'self' data: https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; form-action 'self';"
        -Server
    }

    # Backend API. The backend mounts routes at /api/* itself,
    # so we use `handle` (preserves path) instead of `handle_path` (strips prefix).
    handle /api/* {
        reverse_proxy backend:3001
    }
    @health path /health
    handle @health {
        reverse_proxy backend:3001
    }

    # Static frontend (SPA — fall back to index.html for client routes)
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    # Block obviously hostile probes
    @bad path /.env /.git/* /wp-* /xmlrpc.php /phpmyadmin/*
    respond @bad 404
}
