{
  "permissions": {
    "allow": [
      "Bash(python3 -c \"import json; d=json.load\\(open\\('packages/frontend/public/locales/en/common.json'\\)\\); print\\(list\\(d.get\\('notifications',{}\\).keys\\(\\)\\)\\)\")",
      "Bash(python3 -c \"import json; d=json.load\\(open\\('packages/frontend/public/locales/en/admin.json'\\)\\); print\\(list\\(d.keys\\(\\)\\)[:12]\\); print\\('total lines:', len\\(open\\('packages/frontend/public/locales/en/admin.json'\\).readlines\\(\\)\\)\\)\")",
      "Bash(python3 -c \"import json; d=json.load\\(open\\('packages/frontend/public/locales/en/admin.json'\\)\\); print\\(json.dumps\\(d.get\\('calendar',{}\\), indent=2\\)\\)\")",
      "Bash(grep -nE \"spanish-|slate-|navy-|edu-|gradient-|#[0-9a-fA-F]{3,6}\\\\b|rgb\\\\\\(|hsl\\\\\\(\" packages/frontend/src/components/ui/calendar-event.tsx packages/frontend/src/components/ui/calendar-selection-composer.tsx packages/frontend/src/components/ui/slot-event-drawer.tsx)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-guardrails.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-guardrail-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-frontend.mjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/frontend-stop-gate.mjs\"",
            "timeout": 900
          },
          {
            "type": "agent",
            "prompt": "If frontend source files changed, independently verify both the UX guardian and complete Editorial Teaching Studio UI system: affected requirements and implementation matrix are updated; semantic tokens and canonical components are used; required states, localization, accessibility, responsive screenshots, Storybook/tests, and evidence exist; and both UI/UX and visual review have no blocking issue. Read the diff and rendered evidence. Return ok only when completion is justified. If no frontend source files changed, return ok.",
            "timeout": 240
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-config-change.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/frontend-stop-gate.mjs\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
